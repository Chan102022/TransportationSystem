@model TransportationBookingSystem.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Forgot Password";
}

<style>
    body {
        background-color: pink;
    }
</style>

<h2 class="text-center mb-4">Forgot Password</h2>

<div class="border border-dark rounded p-4 mx-auto" style="max-width: 500px; background-color: #fff;">
    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="d-grid mb-2">
            <button type="submit" class="btn btn-primary btn-block" style="font-weight: bold; padding: 10px 0;">
                Send Password Reset Link
            </button>
        </div>

        <div class="text-center">
            <a asp-action="Login" asp-controller="Account" class="text-decoration-none">Back to Login</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
