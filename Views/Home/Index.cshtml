@using Microsoft.AspNetCore.Identity
@using TransportationBookingSystem.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
    var isAdmin = false;

    if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var roles = await UserManager.GetRolesAsync(user);
        isAdmin = roles.Contains("Admin");
    }
}

<body style="background-color: pink; font-family: Arial, sans-serif; margin: 0; padding: 0;">

    <!-- Page Header -->
    <div style="
        text-align: center;
        padding: 40px 20px 20px 20px;
    ">
        <h1 style="
            font-size: 3rem;
            display: inline-block;
            padding: 10px 30px;
            border: 5px solid black;
            border-radius: 20px;
            background-color: white;
            color: black;
            box-shadow: 3px 3px 8px rgba(0,0,0,0.2);
        ">
            Book Now
        </h1>
    </div>

    <!-- Main Section with Image and Buttons -->
    <div style="
        margin: 40px auto;
        width: 95%;
        max-width: 1300px;
        height: 700px;
        background-image: url('/image/bg.png');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        border: 5px solid black;
        border-radius: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 4px 4px 10px rgba(0,0,0,0.2);
    ">
        <div style="text-align: center;">
            @if (isAdmin)
            {
                <a asp-controller="Admin" asp-action="Dashboard"
                   style="
                           background-color: white;
                           color: black;
                           font-weight: bold;
                           padding: 12px 25px;
                           margin: 10px;
                           border: 5px solid black;
                           border-radius: 10px;
                           text-decoration: none;
                           transition: transform 0.3s ease;
                           display: inline-block;
                       "
                   onmouseover="this.style.transform='scale(1.1)'"
                   onmouseout="this.style.transform='scale(1)'">
                    View All Bookings (Admin)
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Book"
                   style="
                           background-color: white;
                           color: black;
                           font-weight: bold;
                           padding: 12px 25px;
                           margin: 10px;
                           border: 5px solid black;
                           border-radius: 10px;
                           text-decoration: none;
                           transition: transform 0.3s ease;
                           display: inline-block;
                       "
                   onmouseover="this.style.transform='scale(1.1)'"
                   onmouseout="this.style.transform='scale(1)'">
                    View Existing Bookings
                </a>
            }

            <a asp-controller="Home" asp-action="Booking"
               style="
                   background-color: white;
                   color: black;
                   font-weight: bold;
                   padding: 12px 25px;
                   margin: 10px;
                   border: 5px solid black;
                   border-radius: 10px;
                   text-decoration: none;
                   transition: transform 0.3s ease;
                   display: inline-block;
               "
               onmouseover="this.style.transform='scale(1.1)'"
               onmouseout="this.style.transform='scale(1)'">
                Book Now
            </a>
        </div>
    </div>

</body>
