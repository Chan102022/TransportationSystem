@using TransportationBookingSystem.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
    var isAdmin = User.IsInRole("Admin");

    // Get destinations from ViewBag (passed from controller)
    var destinations = ViewBag.Destinations as List<Destination> ?? new List<Destination>();
}

<body style="background-color: pink; font-family: Arial, sans-serif; margin: 0; padding: 0;">

    <!-- Page Header -->
    <div style="text-align: center; padding: 40px 20px 20px 20px;">
        <h1 style="
            font-size: 3rem;
            display: inline-block;
            padding: 15px 40px;
            border: 5px solid black;
            border-radius: 25px;
            background-color: white;
            color: black;
            box-shadow: 4px 4px 10px rgba(0,0,0,0.3);
        ">
            Book Your Ride
        </h1>
    </div>

    <div class="container" style="max-width:1300px; margin: auto; padding: 20px;">

        @if (isAdmin)
        {
            <!-- Admin View -->
            <div style="text-align:center; margin-top:50px;">
                <a asp-controller="Admin" asp-action="Dashboard"
                   style="
                           background-color: white;
                           color: black;
                           font-weight: bold;
                           padding: 15px 30px;
                           border: 5px solid black;
                           border-radius: 15px;
                           text-decoration: none;
                           transition: all 0.3s ease;
                           display: inline-block;
                           box-shadow: 2px 2px 8px rgba(0,0,0,0.2);
                       "
                   onmouseover="this.style.transform='scale(1.05)'; this.style.boxShadow='4px 4px 12px rgba(0,0,0,0.3)';"
                   onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='2px 2px 8px rgba(0,0,0,0.2)';">
                    Admin Dashboard
                </a>
            </div>
        }
        else
        {
            <!-- Regular User View -->
            <h2 style="text-align:center; margin-bottom:40px; color:black; text-decoration:underline;">
                Available Destinations
            </h2>

            <div style="display:flex; flex-wrap:wrap; gap:25px; justify-content:center;">

                @foreach (var dest in destinations)
                {
                    <a asp-controller="Home" asp-action="Booking" asp-route-id="@dest.Name"
                       style="text-decoration:none; color:inherit;">
                        <div style="
                        background-color: white;
                        border: 2px solid black;
                        border-radius: 20px;
                        padding: 25px;
                        width: 260px;
                        text-align: center;
                        box-shadow: 3px 3px 12px rgba(0,0,0,0.2);
                        transition: transform 0.3s, box-shadow 0.3s;
                        display: flex;
                        flex-direction: column;
                        justify-content: space-between;
                    "
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='5px 5px 15px rgba(0,0,0,0.3)';"
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='3px 3px 12px rgba(0,0,0,0.2)';">

                            <h3 style="margin-bottom: 15px; color:#d63384;">@dest.Name</h3>
                            <p style="margin:5px 0; font-weight:bold;">Fare: ₱@dest.Fare.ToString("F2")</p>
                            <p style="margin:5px 0; font-size:0.9rem; color:#555;">Departure: @dest.DepartureTime</p>
                            <p style="margin:5px 0; font-size:0.9rem; color:#555;">Arrival: @dest.ArrivalTime</p>

                        </div>
                    </a>
                }

            </div>
        }
    </div>

</body>
