@model TransportationBookingSystem.Models.Passenger
@{
    ViewData["Title"] = "Booking";
    var destinations = ViewBag.Destinations as List<TransportationBookingSystem.Models.Destination>
                       ?? new List<TransportationBookingSystem.Models.Destination>();
}

<body style="background-color: pink;">

    <div class="container" style="max-width: 800px; margin-top: 40px; border: 5px solid black; padding: 30px; border-radius: 20px; background-color: white;">
        <h1 class="text-center mb-4" style="border-radius: 20px; padding: 10px 0;">Book Now</h1>

        <form asp-action="BookingForm" asp-controller="Home" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- HIDDEN FIELDS -->
            <input type="hidden" name="BookingId" value="@Model.BookingId" />
            <input type="hidden" name="BusNo" value="@Model.BusNo" />
            <input type="hidden" name="SeatNo" value="@Model.SeatNo" />
            <input type="hidden" name="BookingDate" value="@Model.BookingDate.ToString("yyyy-MM-dd HH:mm:ss")" />
            <input type="hidden" name="UserId" value="@Model.UserId" />
            <input type="hidden" name="Status" value="@Model.Status ?? "Pending"" />

            <!-- READONLY FIELDS -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Bus No</label>
                <div class="col-sm-9">
                    <input class="form-control" type="text" value="@Model.BusNo" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Seat No</label>
                <div class="col-sm-9">
                    <input class="form-control" type="text" value="@Model.SeatNo" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Booking Date</label>
                <div class="col-sm-9">
                    <input class="form-control" type="text" value="@Model.BookingDate.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                </div>
            </div>

            <!-- NAME -->
            <div class="mb-3 row align-items-center">
                <label asp-for="Name" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" placeholder="Enter Your Name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <!-- DESTINATION DROPDOWN -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Destination</label>
                <div class="col-sm-9">

                    <select id="destinationSelect"
                            class="form-select"
                            name="Destination"
                            @(Model.Destination != null ? "disabled=\"disabled\"" : "")
                            required>

                        @if (Model.Destination == null)
                        {
                            <option value="" disabled selected>Select Destination</option>
                        }
                        else
                        {
                            <option value="" disabled>Select Destination</option>
                        }

                        @foreach (var dest in destinations)
                        {
                            var isSelected = Model.Destination == dest.Name ? "selected=\"selected\"" : "";
                            var fare = dest.Fare.ToString("F2");
                            var dep = dest.DepartureTime.ToString("yyyy-MM-dd HH:mm");
                            var arr = dest.ArrivalTime.ToString("yyyy-MM-dd HH:mm");

@:<option value="@dest.Name"
@:        data-fare="@fare"
@:        data-departure="@dep"
@:        data-arrival="@arr"
@:        @Html.Raw(isSelected)>    
@:@dest.Name | Fare: ₱@fare | Departure: @dep | Arrival: @arr
@:</option>
                        }
                    </select>

                    <!-- IF LOCKED, SUBMIT VIA HIDDEN INPUT -->
                    @if (Model.Destination != null)
                    {
                        <input type="hidden" name="Destination" value="@Model.Destination" />
                    }
                </div>
            </div>

            <!-- AUTO-FILLED FIELDS -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Departure Time</label>
                <div class="col-sm-9">
                    <input id="departureDisplay" class="form-control" type="text" name="DepartureTime" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Arrival Time</label>
                <div class="col-sm-9">
                    <input id="arrivalDisplay" class="form-control" type="text" name="ArrivalTime" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Fare</label>
                <div class="col-sm-9">
                    <input id="fareDisplay" class="form-control" type="text" name="Fare" readonly />
                </div>
            </div>

            <div class="text-center">
                <button id="simpleAlertBtn" type="submit" class="btn btn-outline-dark px-5 py-2 fw-bold" style="border-width: 3px;">
    Book Now
</button>

            </div>

        </form>
    </div>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")

        <script>
    const destinationSelect = document.getElementById("destinationSelect");
    const fareDisplay = document.getElementById("fareDisplay");
    const departureDisplay = document.getElementById("departureDisplay");
    const arrivalDisplay = document.getElementById("arrivalDisplay");

    function updateFields() {
        const opt = destinationSelect.selectedOptions[0];
        if (!opt) return;

        fareDisplay.value = parseFloat(opt.dataset.fare).toFixed(2);
        departureDisplay.value = opt.dataset.departure;
        arrivalDisplay.value = opt.dataset.arrival;
    }

    destinationSelect.addEventListener("change", updateFields);
    window.addEventListener("load", updateFields);

    // SIMPLE CONFIRMATION BEFORE SUBMITTING
    document.querySelector("form").addEventListener("submit", function (e) {

        let name = document.querySelector("input[name='Name']").value;
        let destination = destinationSelect.value;
        let fare = fareDisplay.value;
        let dep = departureDisplay.value;
        let arr = arrivalDisplay.value;

        let message =
`Are you sure you want to book this trip?

Passenger Name: ${name}
Destination: ${destination}
Fare: ₱${fare}
Departure: ${dep}
Arrival: ${arr}`;

        if (!confirm(message)) {
            e.preventDefault(); // STOP submit
        }
    });
</script>


    }
</body>
