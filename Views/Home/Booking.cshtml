@model TransportationBookingSystem.Models.Passenger

@{
    ViewData["Title"] = "Booking";
    var destinations = ViewBag.Destinations as List<TransportationBookingSystem.Models.Destination>
                       ?? new List<TransportationBookingSystem.Models.Destination>();
}

<body style="background-color: pink;">

    <div class="container" style="max-width: 800px; margin-top: 40px; border: 5px solid black; padding: 30px; border-radius: 20px; background-color: white;">
        <h1 class="text-center mb-4" style="border-radius: 20px; padding: 10px 0;">Book Now</h1>

        <form asp-action="BookingForm" asp-controller="Home" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- HIDDEN FIELDS -->
            <input asp-for="BookingId" type="hidden" />
            <input asp-for="BusNo" type="hidden" />
            <input asp-for="SeatNo" type="hidden" />
            <input asp-for="BookingDate" type="hidden" />
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Status" type="hidden" />

            <!-- Fixed Hidden Fields (no tag helper) -->
            <input type="hidden" name="DestinationId" id="destinationIdHidden" value="@Model.DestinationId" />
            <input type="hidden" name="Destination" id="destinationNameHidden" value="@Model.Destination" />

            <!-- READONLY FIELDS -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Bus No</label>
                <div class="col-sm-9">
                    <input asp-for="BusNo" class="form-control" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Seat No</label>
                <div class="col-sm-9">
                    <input asp-for="SeatNo" class="form-control" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Booking Date</label>
                <div class="col-sm-9">
                    <input class="form-control" value="@Model.BookingDate.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                </div>
            </div>

            <!-- NAME -->
            <div class="mb-3 row align-items-center">
                <label asp-for="Name" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" placeholder="Enter Your Name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <!-- DESTINATION DROPDOWN -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Destination</label>
                <div class="col-sm-9">
                    <select id="destinationSelect"
                            class="form-select"
                            @(Model.DestinationId != null ? "disabled=\"disabled\"" : "")
                            required>

                        @if (Model.DestinationId == null)
                        {
                            <option disabled selected>Select Destination</option>
                        }

                        @foreach (var dest in destinations)
                        {
                            <option value="@dest.Id"
                                    data-name="@dest.Name"
                                    data-fare="@dest.Fare"
                                    data-departure="@dest.DepartureTime.ToString("yyyy-MM-dd HH:mm")"
                                    data-arrival="@dest.ArrivalTime.ToString("yyyy-MM-dd HH:mm")"
                                    selected="@(Model.DestinationId == dest.Id ? "selected" : null)">
                                @dest.Name | Fare: ₱@dest.Fare.ToString("F2")
                                | Departure: @dest.DepartureTime
                                | Arrival: @dest.ArrivalTime
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- AUTO-FILLED FIELDS -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Departure Time</label>
                <div class="col-sm-9">
                    <input id="departureDisplay" asp-for="DepartureTime" class="form-control" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Arrival Time</label>
                <div class="col-sm-9">
                    <input id="arrivalDisplay" asp-for="ArrivalTime" class="form-control" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Fare</label>
                <div class="col-sm-9">
                    <input id="fareDisplay" asp-for="Fare" class="form-control" readonly />
                </div>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-outline-dark px-5 py-2 fw-bold" style="border-width: 3px;">
                    Book Now
                </button>
            </div>

        </form>
    </div>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")

        <script>
                    const destinationSelect = document.getElementById("destinationSelect");
                    const fareField = document.getElementById("fareDisplay");
                    const departureField = document.getElementById("departureDisplay");
                    const arrivalField = document.getElementById("arrivalDisplay");

                    function updateFields() {
                        const opt = destinationSelect.selectedOptions[0];
                        if (!opt) return;

                        fareField.value = parseFloat(opt.dataset.fare).toFixed(2);
                        departureField.value = opt.dataset.departure;
                        arrivalField.value = opt.dataset.arrival;

                        // Update hidden fields
                        document.getElementById("destinationIdHidden").value = opt.value;
                        document.getElementById("destinationNameHidden").value = opt.dataset.name;
                    }

                    destinationSelect.addEventListener("change", updateFields);
                    window.addEventListener("load", updateFields);

                    // Confirmation popup
                    document.querySelector("form").addEventListener("submit", function (e) {
                        const name = document.querySelector("input[name='Name']").value;
                        const destination = document.getElementById("destinationNameHidden").value;
                        const fare = fareField.value;
                        const dep = departureField.value;
                        const arr = arrivalField.value;

                        const message =
            `Are you sure you want to book this trip?

            Passenger Name: ${name}
            Destination: ${destination}
            Fare: ₱${fare}
            Departure: ${dep}
            Arrival: ${arr}`;

                        if (!confirm(message)) {
                            e.preventDefault();
                        }
                    });
        </script>
    }

</body>
