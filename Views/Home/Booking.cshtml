@model TransportationBookingSystem.Models.Passenger
@{
    ViewData["Title"] = "Booking";
    var destinations = ViewBag.Destinations as List<TransportationBookingSystem.Models.Destination> ?? new List<TransportationBookingSystem.Models.Destination>();
}

<body style="background-color: pink;">
    <div class="container" style="max-width: 800px; margin-top: 40px; border: 5px solid black; padding: 30px; border-radius: 20px; background-color: white;">
        <h1 class="text-center mb-4" style="border-radius: 20px; padding: 10px 0;">Book Now</h1>

        <form asp-action="BookingForm" asp-controller="Home" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>
            <!-- Hidden / readonly fields -->
            <input type="hidden" name="BookingId" value="@Model.BookingId" />
            <input type="hidden" name="BusNo" value="@Model.BusNo" />
            <input type="hidden" name="SeatNo" value="@Model.SeatNo" />
            <input type="hidden" name="BookingDate" value="@Model.BookingDate.ToString("yyyy-MM-dd HH:mm:ss")" />
            <input type="hidden" name="UserId" value="@Model.UserId" />
            <input type="hidden" name="Status" value="@Model.Status ?? " Pending"" />


            <!-- Hidden/readonly fields visible -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Bus No</label>
                <div class="col-sm-9">
                    <input class="form-control" type="text" value="@Model.BusNo" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Seat No</label>
                <div class="col-sm-9">
                    <input class="form-control" type="text" value="@Model.SeatNo" readonly />
                </div>
            </div>

            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Booking Date</label>
                <div class="col-sm-9">
                    <input class="form-control" type="text" value="@Model.BookingDate.ToString("yyyy-MM-dd HH:mm:ss")" readonly />
                </div>
            </div>

            <!-- Passenger Name -->
            <div class="mb-3 row align-items-center">
                <label asp-for="Name" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" placeholder="Enter Your Name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <!-- Destination Dropdown (from homepage info) -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Destination</label>
                <div class="col-sm-9">
                    <select id="destinationSelect" class="form-select" name="Destination" required>
                        <option value="" disabled selected hidden>Select Destination</option>
                        @foreach (var dest in destinations)
                        {
                            <option value="@dest.Name"
                                    data-fare="@dest.Fare"
                                    data-departure="@dest.DepartureTime.ToString("yyyy-MM-dd HH:mm")"
                                    data-arrival="@dest.ArrivalTime.ToString("yyyy-MM-dd HH:mm")">
                                @dest.Name | Fare: ₱@dest.Fare.ToString("F2") | Departure: @dest.DepartureTime.ToString("yyyy-MM-dd HH:mm") | Arrival: @dest.ArrivalTime.ToString("yyyy-MM-dd HH:mm")
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- Fare Display -->
            <div class="mb-3 row align-items-center">
                <label class="col-sm-3 col-form-label">Fare</label>
                <div class="col-sm-9">
                    <input id="fareDisplay" class="form-control" type="text" name="Fare" readonly placeholder="Select a destination" />
                </div>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-outline-dark px-5 py-2 fw-bold" style="border-width: 3px;">
                    Book Now
                </button>
            </div>
        </form>
    </div>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")
        <script>
            const destinationSelect = document.getElementById("destinationSelect");
            const fareDisplay = document.getElementById("fareDisplay");

            destinationSelect.addEventListener("change", function () {
                const selectedOption = this.selectedOptions[0];
                const fare = selectedOption.dataset.fare;

                fareDisplay.value = fare ? parseFloat(fare).toFixed(2) : '';
            });
        </script>
    }
</body>
