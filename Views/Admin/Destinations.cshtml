@model List<TransportationBookingSystem.Models.Destination>

@{
    ViewData["Title"] = "Manage Destinations";
}

<body style="background-color: pink; font-family: Arial, sans-serif; margin: 0; padding: 0;">

    <div style="
        border: 5px solid black;
        background-color: white;
        border-radius: 20px;
        padding: 30px;
        margin: 40px auto;
        width: 95%;
        max-width: 1300px;
        text-align: center;
        box-shadow: 4px 4px 10px rgba(0,0,0,0.2);
    ">

        <!-- Heading -->
        <h1 style="
            font-size: 2.5rem;
            margin-bottom: 30px;
            padding: 10px 30px;
            display: inline-block;
            border: 5px solid black;
            border-radius: 20px;
            background-color: pink;
        ">
            Destination Management
        </h1>

        <!-- GLOBAL TIME SLOT SETTINGS -->
        <div style="margin-bottom: 40px; text-align: left;">
            <h4>Time Slot Settings</h4>

            <form asp-controller="TimeSettings" asp-action="Save" method="post"
                  style="display: flex; flex-direction: column; gap: 15px; max-width: 400px;">

                <div>
                    <label>Slot 1 (Morning)</label>
                    <div class="d-flex gap-2">
                        <input type="time" name="Slot1Start" class="form-control" value="@ViewBag.TimeSlots.Slot1Start" required />
                        <input type="time" name="Slot1End" class="form-control" value="@ViewBag.TimeSlots.Slot1End" required />
                    </div>
                </div>

                <div>
                    <label>Slot 2 (Late Morning)</label>
                    <div class="d-flex gap-2">
                        <input type="time" name="Slot2Start" class="form-control" value="@ViewBag.TimeSlots.Slot2Start" required />
                        <input type="time" name="Slot2End" class="form-control" value="@ViewBag.TimeSlots.Slot2End" required />
                    </div>
                </div>

                <div>
                    <label>Slot 3 (Afternoon)</label>
                    <div class="d-flex gap-2">
                        <input type="time" name="Slot3Start" class="form-control" value="@ViewBag.TimeSlots.Slot3Start" required />
                        <input type="time" name="Slot3End" class="form-control" value="@ViewBag.TimeSlots.Slot3End" required />
                    </div>
                </div>

                <div>
                    <label>Slot 4 (Evening)</label>
                    <div class="d-flex gap-2">
                        <input type="time" name="Slot4Start" class="form-control" value="@ViewBag.TimeSlots.Slot4Start" required />
                        <input type="time" name="Slot4End" class="form-control" value="@ViewBag.TimeSlots.Slot4End" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-sm btn-outline-success">Save Time Slots</button>
            </form>

            <hr style="margin-top: 25px;" />
        </div>


        <!-- Add New Destination Form -->
        <div style="margin-bottom: 30px; text-align: left;">
            <h4>Add New Destination</h4>

            <form asp-action="AddDestination" asp-controller="Admin"
                  method="post" class="d-flex flex-wrap gap-2 align-items-end" id="addDestinationForm">

                <div class="d-flex flex-column">
                    <input type="text" name="name" class="form-control"
                           placeholder="Departure-Arrival" required id="routeNameInput" />
                </div>

                <input type="number" name="fare" class="form-control"
                       placeholder="Fare" step="0.01" required />

                <button type="submit" class="btn btn-sm btn-outline-dark" id="addButton">Add</button>
            </form>

            <!-- Warning Message -->
            <small id="duplicateWarning" style="color: red; font-weight: bold; display: none;">
                This route already exists.
            </small>
        </div>

        <!-- Destinations Table -->
        <h4>All Destinations</h4>
        <table style="width:100%; border-collapse: collapse; margin-top: 20px;">
            <thead style="background-color: pink; color: black;">
                <tr>
                    <th style="border: 3px solid black; padding: 10px;">ID</th>
                    <th style="border: 3px solid black; padding: 10px;">Name</th>
                    <th style="border: 3px solid black; padding: 10px;">Fare</th>
                    <th style="border: 3px solid black; padding: 10px;">Departure</th>
                    <th style="border: 3px solid black; padding: 10px;">Arrival</th>
                    <th style="border: 3px solid black; padding: 10px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dest in Model)
                {
                    <tr style="background-color: #fdfdfd;">
                        <td style="border: 2px solid black; padding: 10px;">@dest.Id</td>
                        <td style="border: 2px solid black; padding: 10px;">@dest.Name</td>
                        <td style="border: 2px solid black; padding: 10px;">@dest.Fare.ToString("F2")</td>
                        <td style="border: 2px solid black; padding: 10px;">@dest.DepartureTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="border: 2px solid black; padding: 10px;">@dest.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="border: 2px solid black; padding: 10px;">
                            <form asp-action="EditDestination" asp-controller="Admin"
                                  method="post" class="d-flex flex-wrap gap-2 align-items-end">

                                <input type="hidden" name="id" value="@dest.Id" />

                                <input type="text" name="name" value="@dest.Name"
                                       class="form-control form-control-sm" required />

                                <input type="number" name="fare"
                                       value="@dest.Fare.ToString("F2")"
                                       class="form-control form-control-sm" step="0.01" required />

                                <input type="datetime-local" name="departureTime"
                                       value="@dest.DepartureTime.ToString("yyyy-MM-ddTHH:mm")"
                                       class="form-control form-control-sm" required />

                                <input type="datetime-local" name="arrivalTime"
                                       value="@dest.ArrivalTime.ToString("yyyy-MM-ddTHH:mm")"
                                       class="form-control form-control-sm" required />

                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>

                                <a asp-action="DeleteDestination" asp-controller="Admin" asp-route-id="@dest.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure you want to delete this destination?');">
                                    Delete
                                </a>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <!-- JAVASCRIPT -->
    <script>
        // Existing routes from backend
        const existingRoutes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.Select(d => d.Name.ToLower().Trim()).Distinct().ToList()
                ));

        const nameInput = document.querySelector("#routeNameInput");
        const addButton = document.querySelector("#addButton");
        const warning = document.querySelector("#duplicateWarning");

        // Duplicate check
        nameInput.addEventListener("input", function () {
            const inputValue = nameInput.value.toLowerCase().trim();

            if (existingRoutes.includes(inputValue)) {
                warning.style.display = "block";
                addButton.disabled = true;
            } else {
                warning.style.display = "none";
                addButton.disabled = false;
            }
        });

        // Confirm Add
        const addForm = document.querySelector("#addDestinationForm");
        addForm.addEventListener("submit", function (e) {
            if (!confirm("Are you sure you want to add this destination?")) {
                e.preventDefault();
            }
        });
    </script>

</body>
