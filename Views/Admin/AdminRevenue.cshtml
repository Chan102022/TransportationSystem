@model List<TransportationBookingSystem.Models.Passenger>

@{
    ViewData["Title"] = "Daily / Monthly Earnings";
}

<style>
    body {
        background-color: pink;
        font-family: Arial, sans-serif;
    }

    .earnings-wrapper {
        background: white;
        border: 5px solid black;
        border-radius: 20px;
        padding: 35px;
        margin-top: 40px;
        box-shadow: 5px 5px 12px rgba(0,0,0,0.25);
    }

    .title-box {
        background: #ffb6d9;
        border: 4px solid black;
        border-radius: 15px;
        padding: 12px 25px;
        display: inline-block;
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .total-box {
        background: #ffe1f0;
        border: 3px solid black;
        padding: 18px;
        border-radius: 12px;
        font-size: 1.4rem;
        font-weight: bold;
        margin-bottom: 25px;
        text-align: center;
    }

    .btn-theme {
        background-color: #ffe6f2 !important;
        border: 3px solid black !important;
        font-weight: bold !important;
        transition: 0.2s;
    }

        .btn-theme:hover {
            background-color: #ffbfdc !important;
        }

    table {
        border: 3px solid black !important;
        background: white;
    }

    thead th {
        background-color: #ffb6d9 !important;
        border: 2px solid black !important;
        color: black !important;
    }

    tbody td {
        border: 2px solid black !important;
    }
</style>

<div class="container earnings-wrapper">

    <!-- Heading -->
    <div class="text-center">
        <div class="title-box">@ViewBag.EarningsTitle</div>
    </div>

    <!-- Filter Form -->
    <form method="get" class="text-center mb-4">
        <label><strong>Select Date:</strong></label>

        <input type="date"
               name="date"
               value="@ViewBag.SelectedDate"
               class="form-control d-inline-block"
               style="width:230px; border:2px solid black;" />

        <!-- Daily Button -->
        <button type="submit" class="btn btn-theme ms-2">
            Show Daily
        </button>

        <!-- Monthly Button -->
        <button type="submit" class="btn btn-theme ms-2"
                name="monthly" value="true">
            📅 Show Monthly
        </button>
    </form>

    <!-- Total Earnings Box -->
    <div class="total-box">
        Total Earnings: ₱@(((decimal)ViewBag.TotalEarnings).ToString("N2"))
    </div>

    <!-- Table Results -->
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Booking ID</th>
                <th>Name</th>
                <th>Destination</th>
                <th>Fare</th>
                <th>Seat No</th>
                <th>Departure</th>
                <th>Paid At</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.BookingId</td>
                    <td>@booking.Name</td>
                    <td>@booking.Destination</td>
                    <td>₱@booking.Fare.ToString("N2")</td>
                    <td>@booking.SeatNo</td>
                    <td>@booking.DepartureTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@booking.DatePaid?.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <p class="text-center"><em>No paid bookings found.</em></p>
    }
</div>
