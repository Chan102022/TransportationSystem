@model List<TransportationBookingSystem.Models.Passenger>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background-color: pink;
    }

    .card {
        background-color: white;
        border: 2px solid black;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 30px;
    }

    table th, table td {
        vertical-align: middle !important;
    }

    .form-inline select {
        margin-right: 10px;
    }
</style>

<div class="container mt-4">
    <h1 class="text-center mb-4">Admin Dashboard</h1>

    <div class="card">
        <h4>All Bookings</h4>

        <div class="card mb-3 p-3">
            <h4>Filter Bookings</h4>
            <form asp-action="Dashboard" asp-controller="Admin" method="get" class="d-flex gap-2 flex-wrap">
                <div class="d-flex flex-column">
                    <label>Status</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">All</option>
                        <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending" ? "selected" : null)">Pending</option>
                        <option value="Confirmed" selected="@(ViewBag.StatusFilter == "Confirmed" ? "selected" : null)">Confirmed</option>
                        <option value="Canceled" selected="@(ViewBag.StatusFilter == "Canceled" ? "selected" : null)">Canceled</option>
                    </select>
                </div>

                <div class="d-flex flex-column">
                    <label>Destination</label>
                    <select name="routeFilter" class="form-select">
                        <option value="">All</option>
                        @foreach (var route in ViewBag.Routes as List<string> ?? new List<string>())
                        {
                            <option value="@route" selected="@(ViewBag.RouteFilter == route ? "selected" : null)">@route</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-outline-dark align-self-end">Filter</button>
            </form>
        </div>

        <table class="table table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Passenger Name</th>
                    <th>Route</th>

                    <!-- Added columns -->
                    <th>Departure Time</th>
                    <th>Arrival Time</th>

                    <th>Fare (₱)</th>
                    <th>Bus No</th>
                    <th>Seat No</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Update Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.Name</td>
                        <td>@booking.Destination</td>

                        <!-- NEW TIME DISPLAY -->
                        <td>@booking.DepartureTime</td>
                        <td>@booking.ArrivalTime</td>

                        <td>@booking.Fare.ToString("N2")</td>
                        <td>@booking.BusNo</td>
                        <td>@booking.SeatNo</td>
                        <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@booking.Status</td>

                        <td>
                            <form asp-action="UpdateStatus" asp-controller="Admin" method="post" class="d-flex">
                                <input type="hidden" name="BookingId" value="@booking.BookingId" />

                                <select name="Status" class="form-select me-2">
                                    <option value="Pending" selected="@(booking.Status == "Pending")">Pending</option>
                                    <option value="Confirmed" selected="@(booking.Status == "Confirmed")">Confirmed</option>
                                    <option value="Canceled" selected="@(booking.Status == "Canceled")">Canceled</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-outline-dark">Update</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
