@model List<TransportationBookingSystem.Models.Passenger>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background-color: pink;
        font-family: Arial, sans-serif;
    }

    .card {
        background-color: white;
        border: 3px solid black;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 30px;
    }

    table th, table td {
        vertical-align: middle !important;
        border: 2px solid black !important;
    }

    .btn-custom-dark {
        border: 2px solid black !important;
        font-weight: bold;
        background: #ffe6f3;
    }

        .btn-custom-dark:hover {
            background: #ffbfdf;
        }

    .btn-custom-danger {
        border: 2px solid black !important;
        font-weight: bold;
        background: #ffcccc;
    }

        .btn-custom-danger:hover {
            background: #ff9999;
        }

    .bulk-box {
        margin-bottom: 20px;
        display: flex;
        gap: 15px;
        align-items: center;
    }

        .bulk-box select {
            max-width: 200px;
        }
</style>

<div class="container mt-4">
    <h1 class="text-center mb-4"
        style="font-weight: bold; border: 4px solid black; background:#ffb6d9; padding:10px; border-radius:15px;">
        🚌 Admin Dashboard
    </h1>

    <div class="card">
        <h4>Bookings Today</h4>

        <!-- ======================== -->
        <!-- BULK UPDATE SECTION      -->
        <!-- ======================== -->
        <div class="bulk-box">
            <input type="checkbox" id="selectAll" />
            <label for="selectAll"><b>Select All</b></label>

            <select id="bulkStatus" class="form-select">
                <option value="">Bulk Action: Update Status</option>
                <option value="Pending">Pending</option>
                <option value="Confirmed">Confirmed</option>
                <option value="Canceled">Canceled</option>
            </select>

            <button id="applyBulk" class="btn btn-custom-dark">Apply</button>
        </div>


        <!-- FILTER BAR -->
        <div class="card mb-3 p-3">
            <h4>Filter Bookings</h4>
            <form asp-action="Dashboard" asp-controller="Admin" method="get" class="d-flex gap-3 flex-wrap">

                <!-- Status Filter -->
                <div class="d-flex flex-column">
                    <label>Status</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">All</option>
                        <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(ViewBag.StatusFilter == "Confirmed")">Confirmed</option>
                        <option value="Canceled" selected="@(ViewBag.StatusFilter == "Canceled")">Canceled</option>
                    </select>
                </div>

                <!-- Destination Filter -->
                <div class="d-flex flex-column">
                    <label>Destination</label>
                    <select name="routeFilter" class="form-select">
                        <option value="">All</option>
                        @foreach (var route in ViewBag.Routes as List<string> ?? new List<string>())
                        {
                            <option value="@route" selected="@(ViewBag.RouteFilter == route)">
                                @route
                            </option>
                        }
                    </select>
                </div>

                <!-- Date Filter -->
                <div class="d-flex flex-column">
                    <label>Date</label>
                    <input type="date" name="dateFilter" class="form-control"
                           value="@(ViewBag.DateFilter ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                </div>

                <button type="submit" class="btn btn-custom-dark align-self-end">Filter</button>
            </form>
        </div>


        <!-- ======================== -->
        <!-- TABLE OF BOOKINGS        -->
        <!-- ======================== -->
        <table class="table table-bordered mt-3" id="bookingTable">
            <thead style="background-color:#ffb6d9; font-weight:bold;">
                <tr>
                    <th><input type="checkbox" id="headerSelectAll" /></th>
                    <th>Passenger Name</th>
                    <th>Route</th>
                    <th>Departure</th>
                    <th>Arrival</th>
                    <th>Fare (₱)</th>
                    <th>Bus No</th>
                    <th>Seat</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="rowCheck" value="@booking.BookingId" />
                        </td>

                        <td>@booking.Name</td>
                        <td>@booking.Destination</td>
                        <td>@booking.DepartureTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@booking.ArrivalTime.ToString("yyyy-MM-dd HH:mm")</td>

                        <td>@booking.Fare.ToString("N2")</td>
                        <td>@booking.BusNo</td>
                        <td>@booking.SeatNo</td>
                        <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>

                        <td><b>@booking.Status</b></td>

                        <td>
                            <form asp-action="UpdateStatus" asp-controller="Admin" method="post" class="d-flex me-2">
                                <input type="hidden" name="BookingId" value="@booking.BookingId" />

                                <select name="Status" class="form-select me-2">
                                    <option value="Pending" selected="@(booking.Status == "Pending")">Pending</option>
                                    <option value="Confirmed" selected="@(booking.Status == "Confirmed")">Confirmed</option>
                                    <option value="Canceled" selected="@(booking.Status == "Canceled")">Canceled</option>
                                </select>

                                <button type="submit" class="btn btn-custom-dark btn-sm">Update</button>
                            </form>

                            <form asp-action="DeleteBooking" asp-controller="Admin" method="post" class="delete-form">
                                <input type="hidden" name="BookingId" value="@booking.BookingId" />
                                <button type="button" class="btn btn-custom-danger btn-sm w-100 delete-btn">
                                    Delete
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>

        /* ==========================
           DELETE BUTTON CONFIRMATION
           ========================== */
        document.querySelectorAll(".delete-btn").forEach(button => {
            button.addEventListener("click", function () {
                let form = this.closest("form");
                if (confirm("⚠ Delete this booking? This cannot be undone.")) {
                    form.submit();
                }
            });
        });

        /* ==========================
           SELECT ALL CHECKBOXES
           ========================== */
        const selectAll = document.getElementById("selectAll");
        const headerSelectAll = document.getElementById("headerSelectAll");

        function toggleAll(state) {
            document.querySelectorAll(".rowCheck").forEach(chk => chk.checked = state);
            selectAll.checked = state;
            headerSelectAll.checked = state;
        }

        selectAll.addEventListener("change", () => toggleAll(selectAll.checked));
        headerSelectAll.addEventListener("change", () => toggleAll(headerSelectAll.checked));

        /* ==========================
           BULK STATUS UPDATE
           ========================== */
        document.getElementById("applyBulk").addEventListener("click", function () {

            const newStatus = document.getElementById("bulkStatus").value;
            if (!newStatus) {
                alert("Please select a status.");
                return;
            }

            const selected = [...document.querySelectorAll(".rowCheck:checked")].map(x => x.value);

            if (selected.length === 0) {
                alert("No bookings selected.");
                return;
            }

            if (!confirm(`Update ${selected.length} bookings to "${newStatus}"?`)) return;

            // POST request
            fetch("/Admin/BulkUpdateStatus", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids: selected, status: newStatus })
            }).then(() => location.reload());
        });
    </script>
}
